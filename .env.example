# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — Settings > API > service_role (secret). Required by nearly every
# server action (lib/supabase/admin.ts) since the app reads/writes Postgres exclusively
# through this client, bypassing RLS by design (see 04-self-hosting-101.md §4 for why).
# NEVER prefix this with NEXT_PUBLIC_ — it must stay server-only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of this app — used to build the Google OAuth redirect target
# (must match a URL registered as an Authorized Redirect in Google Cloud Console
# and match Supabase Auth's configured Site URL / Redirect URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret pepper mixed into OTP hashes before storing (app/actions/auth-actions.ts,
# auth-staff.ts) — generate a long random string, e.g. `openssl rand -hex 32`.
OTP_PEPPER=your-random-pepper-string

# Symmetric key that encrypts each staff member's TOTP MFA secret at rest, via
# pgcrypto pgp_sym_encrypt (RPCs set_staff_mfa_secret / get_staff_mfa_secret).
# Generate with `openssl rand -base64 32`. Server-only, no NEXT_PUBLIC_ prefix.
# Back this up securely — losing it means every staff member must re-enroll MFA.
MFA_SECRET_KEY=your-base64-32-byte-key

# Google Gemini API key — powers both chatbots (app/api/chat, app/api/staff-chat).
# Server-only, no NEXT_PUBLIC_ prefix. Get one from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Gmail SMTP — used to send the "PDF link" email after a return request is submitted
# (customer + CSR flows). Use a Gmail/Workspace App Password, not the account password
# (requires 2-Step Verification enabled on the sending account to generate one).
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465
GMAIL_SMTP_USER=your-sending-address@yourdomain.com
GMAIL_SMTP_PASSWORD=your-16-char-app-password

# Sentry error/performance monitoring — DSN from Sentry project settings > Client Keys
NEXT_PUBLIC_SENTRY_DSN=https://xxx@oXXXXXXX.ingest.us.sentry.io/XXXXXXX
# Optional — only needed to upload source maps at build time (Settings > Auth Tokens,
# scope project:releases). Build works fine without it, just skips source map upload.
SENTRY_AUTH_TOKEN=
